<title>Drawdown Signal Board</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap">
<style>
/* Layout: status chips first, then what fires next, then evidence. Blue = calm / implied, orange = alert / VXN, ink = price */
:root {
  --bg: #f5f6f8;
  --surface: #fcfcfd;
  --fg: #0e1116;
  --fg2: #4a5260;
  --muted: #7c8592;
  --grid: #e3e6ea;
  --axis: #c4c9d0;
  --blue: #2a78d6;
  --blue-soft: rgba(42, 120, 214, 0.10);
  --orange: #eb6834;
  --orange-soft: rgba(235, 104, 52, 0.10);
  --blue-mid: rgba(42, 120, 214, 0.45);
  --orange-mid: rgba(235, 104, 52, 0.45);
  --band: rgba(14, 17, 22, 0.06);
  --ring: rgba(14, 17, 22, 0.10);
  --font-body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-data: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f1115; --surface: #16191e; --fg: #f2f4f7; --fg2: #b9c0ca; --muted: #8a929d; --grid: #262a31; --axis: #3a3f47;
    --blue: #3987e5; --blue-soft: rgba(57, 135, 229, 0.16); --orange: #d95926; --orange-soft: rgba(217, 89, 38, 0.16);
    --band: rgba(242, 244, 247, 0.07); --ring: rgba(255, 255, 255, 0.10); color-scheme: dark;
    --blue-mid: rgba(57, 135, 229, 0.50); --orange-mid: rgba(217, 89, 38, 0.50);
  }
}
:root[data-theme="dark"] {
  --bg: #0f1115; --surface: #16191e; --fg: #f2f4f7; --fg2: #b9c0ca; --muted: #8a929d; --grid: #262a31; --axis: #3a3f47;
  --blue: #3987e5; --blue-soft: rgba(57, 135, 229, 0.16); --orange: #d95926; --orange-soft: rgba(217, 89, 38, 0.16);
  --band: rgba(242, 244, 247, 0.07); --ring: rgba(255, 255, 255, 0.10); color-scheme: dark;
  --blue-mid: rgba(57, 135, 229, 0.50); --orange-mid: rgba(217, 89, 38, 0.50);
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 15px; line-height: 1.5; }
.wrap { max-width: 1120px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 32px); padding-block: 24px 64px; display: grid; gap: 36px; }
header { display: grid; gap: 6px; }
.eyebrow { font-family: var(--font-data); font-size: 12px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; }
h1 { font-size: clamp(26px, 4vw, 34px); line-height: 1.15; margin: 0; font-weight: 700; letter-spacing: -0.01em; text-wrap: balance; }
h2 { font-size: 18px; margin: 0; font-weight: 600; text-wrap: balance; }
section { display: grid; gap: 14px; min-width: 0; }
.sub { color: var(--fg2); margin: 0; max-width: 76ch; }
.note { font-size: 13px; color: var(--muted); margin: 0; max-width: 84ch; }
.live { font-family: var(--font-data); font-size: 11.5px; letter-spacing: 0.04em; border: 1px solid var(--orange); color: var(--orange); padding: 1px 7px; border-radius: 3px; }
.closed { font-family: var(--font-data); font-size: 11.5px; letter-spacing: 0.04em; border: 1px solid var(--axis); color: var(--fg2); padding: 1px 7px; border-radius: 3px; }

/* barometer */
.baro { background: var(--surface); border: 1px solid var(--ring); border-radius: 8px; padding: 18px 20px; display: grid; grid-template-columns: minmax(150px, 210px) 1fr; gap: 18px 28px; align-items: center; }
.baro .k { font-size: 12px; color: var(--muted); font-family: var(--font-data); letter-spacing: 0.04em; text-transform: uppercase; }
.baro-band { font: 600 15px var(--font-body); margin-top: 6px; }
.call-word { font-size: 64px; font-weight: 700; line-height: 1; letter-spacing: 0.01em; }
.call-word.buy { color: var(--blue); } .call-word.sell { color: var(--orange); }
.calls { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
.calls .c { border: 1px solid var(--ring); border-radius: 6px; padding: 8px 10px; font: 12.5px var(--font-data); color: var(--fg2); display: grid; gap: 2px; }
.calls .c .w { font: 700 15px var(--font-body); color: var(--fg); }
.calls .c.buy .w { color: var(--blue); } .calls .c.sell .w { color: var(--orange); }
.calls .c.cur { outline: 3px solid var(--fg); outline-offset: 1px; }
.drv-k { font: 600 12.5px var(--font-data); color: var(--fg); padding: 2px 0; }
.baro-right { display: grid; gap: 12px; min-width: 0; }
.baro p { margin: 0; color: var(--fg2); max-width: 80ch; }
.baro p b { color: var(--fg); }
.drivers { display: flex; flex-wrap: wrap; gap: 6px 8px; }
.drv { font: 12.5px var(--font-data); border: 1px solid var(--axis); border-radius: 4px; padding: 2px 8px; color: var(--fg2); }
.drv.up { border-color: var(--orange); } .drv.dn { border-color: var(--blue); }
.drv b { color: var(--fg); font-weight: 600; }
@media (max-width: 640px) { .baro { grid-template-columns: 1fr; } .call-word { font-size: 52px; } .calls { grid-template-columns: 1fr; } }

/* status chips */
.chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(138px, 1fr)); gap: 10px; }
.chip { background: var(--surface); border: 1px solid var(--ring); border-radius: 6px; padding: 12px 14px; display: grid; gap: 4px; align-content: start; min-width: 0; }
.chip .k { font-size: 12px; color: var(--muted); font-family: var(--font-data); letter-spacing: 0.03em; text-transform: uppercase; }
.chip .state { display: flex; align-items: center; gap: 8px; font-size: 20px; font-weight: 600; }
.chip .why { font-size: 12.5px; color: var(--fg2); font-family: var(--font-data); }
.dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--axis); flex: none; }
.chip.alert { border-color: var(--orange); background: linear-gradient(var(--orange-soft), var(--orange-soft)), var(--surface); }
.chip.alert .dot { background: var(--orange); border-color: var(--orange); }
.chip.alert .state { color: var(--orange); }
.chip.calm { border-color: var(--blue); background: linear-gradient(var(--blue-soft), var(--blue-soft)), var(--surface); }
.chip.calm .dot { background: var(--blue); border-color: var(--blue); }
.chip.calm .state { color: var(--blue); }
.chip.neutral .dot { background: var(--fg); border-color: var(--fg); }

/* tables */
.tbl { overflow-x: auto; border: 1px solid var(--ring); border-radius: 6px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 13.5px; }
th, td { padding: 7px 10px; text-align: right; white-space: nowrap; }
th { font: 500 11.5px var(--font-data); color: var(--muted); letter-spacing: 0.03em; text-transform: uppercase; border-bottom: 1px solid var(--axis); }
td { font-family: var(--font-data); border-bottom: 1px solid var(--grid); font-variant-numeric: tabular-nums; }
tr:last-child td { border-bottom: 0; }
th:first-child, td:first-child { text-align: left; }
td.l, th.l { text-align: left; }
td.wrap { white-space: normal; text-align: left; font-family: var(--font-body); color: var(--fg2); }
.wrapbox { min-width: 280px; max-width: 760px; }
tr.hl td { background: var(--band); font-weight: 600; }
.tag { font: 600 11px var(--font-data); padding: 0 6px; border-radius: 3px; border: 1px solid var(--axis); color: var(--fg2); letter-spacing: 0.03em; }
.tag.on { border-color: var(--orange); color: var(--orange); }
.tag.calm { border-color: var(--blue); color: var(--blue); }
.tag.hi { background: var(--orange); border-color: var(--orange); color: var(--surface); }

/* charts */
.controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
.seg { display: inline-flex; border: 1px solid var(--axis); border-radius: 5px; overflow: hidden; }
.seg button { font: 500 13px var(--font-data); background: transparent; color: var(--fg2); border: 0; padding: 6px 12px; cursor: pointer; }
.seg button + button { border-left: 1px solid var(--axis); }
.seg button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
.seg button:focus-visible, .stack:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13px; color: var(--fg2); }
.key { display: inline-block; width: 14px; height: 2px; vertical-align: middle; margin-right: 6px; border-radius: 1px; }
.key.blue { background: var(--blue); } .key.orange { background: var(--orange); } .key.ink { background: var(--fg); }
.key.band { background: var(--band); height: 10px; width: 12px; }
.key.mh { width: 10px; height: 10px; border-radius: 50%; background: var(--orange); }
.key.mw { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--orange); background: transparent; }
.key.mwt { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); }
.readout { display: flex; flex-wrap: wrap; gap: 4px 16px; font-family: var(--font-data); font-size: 13px; color: var(--fg2); min-height: 20px; }
.readout b { color: var(--fg); font-weight: 600; }
.stack { background: var(--surface); border: 1px solid var(--ring); border-radius: 6px; padding: 8px 4px 4px; outline: none; touch-action: pan-y; }
.panel { position: relative; }
.panel .ttl { position: absolute; left: 52px; top: 3px; font-size: 12px; color: var(--fg2); font-family: var(--font-data); pointer-events: none; }
svg { display: block; width: 100%; overflow: visible; }
svg text { font-family: var(--font-data); font-size: 11px; fill: var(--muted); }
.gl { stroke: var(--grid); stroke-width: 1; }
.ax { stroke: var(--axis); stroke-width: 1; }
.ref { stroke: var(--muted); stroke-width: 1; opacity: 0.75; }
.ln { fill: none; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
.ln.blue { stroke: var(--blue); } .ln.orange { stroke: var(--orange); } .ln.ink { stroke: var(--fg); }
.pt { stroke: var(--surface); stroke-width: 2; }
.pt.blue { fill: var(--blue); } .pt.orange { fill: var(--orange); } .pt.ink { fill: var(--fg); }
.mk-h { fill: var(--orange); stroke: var(--surface); stroke-width: 1.5; }
.mk-w { fill: var(--surface); stroke: var(--orange); stroke-width: 2; }
.mk-watch { fill: var(--blue); }
.xh { stroke: var(--fg2); stroke-width: 1; opacity: 0.55; }
.bandr { fill: var(--band); }
.endlbl { font-weight: 600; fill: var(--fg); }
@media (prefers-reduced-motion: no-preference) { .seg button { transition: background .12s; } }
</style>

<div class="wrap">
<header>
  <div class="eyebrow" id="asof"></div>
  <h1>Drawdown Signal Board</h1>
  <p class="sub">One SPY call: BUY, HOLD or SELL, from VIX, VXN and VVIX rate of change, duration-hedged HYG, Cboe dispersion (DSPX) and the dollar (DXY). Rules and evidence below.</p>
</header>

<section aria-label="SPY call" class="baro" id="call">
  <div>
    <div class="k">SPY call</div>
    <div class="call-word" id="call-word">–</div>
    <div class="baro-band" id="call-since"></div>
  </div>
  <div class="baro-right">
    <p id="call-why"></p>
    <p id="call-flip"></p>
    <div class="calls" id="call-cells"></div>
    <p class="note" id="call-note"></p>
    <div class="drivers" id="baro-drivers"></div>
  </div>
</section>

<section aria-label="Status">
  <div class="chips" id="chips"></div>
</section>

<section aria-label="Components">
  <h2>Components now</h2>
  <div class="tbl"><table id="t-comp"></table></div>
</section>

<section aria-label="Trigger ladder">
  <h2>What fires it on the next closes</h2>
  <div class="tbl"><table id="t-ladder"></table></div>
  <p class="note" id="ladder-note"></p>
</section>

<section aria-label="Charts">
  <h2>Since mid-2020</h2>
  <div class="controls">
    <div class="seg" role="group" aria-label="Date range" id="range">
      <button type="button" data-d="182" aria-pressed="false">6M</button>
      <button type="button" data-d="365" aria-pressed="true">1Y</button>
      <button type="button" data-d="1095" aria-pressed="false">3Y</button>
      <button type="button" data-d="all" aria-pressed="false">All</button>
    </div>
    <div class="legend">
      <span><i class="key mh"></i>High conviction</span><span><i class="key mw"></i>Working</span><span><i class="key mwt"></i>Watch session</span>
      <span><i class="key band"></i>SPY high → low, 5%+ drawdowns</span>
    </div>
  </div>
  <div class="readout" id="readout" aria-live="polite"></div>
  <div class="stack" id="stack" tabindex="0" aria-label="Synced charts. Left and right arrow keys move the date."></div>
  <p class="note">10-session panel: VIX blue, VXN orange, VVIX ink, rule at +10%. Markers show the first print of each tier per 20 sessions.</p>
</section>

<section aria-label="Track record">
  <h2>Track record</h2>
  <p class="sub">First print per 20 sessions. Hit = SPY falls 5% / 8% from that close within 40 sessions. Caught = the tier printed in the 40 sessions before SPY's first close 5% below its 52-week high.</p>
  <div class="tbl"><table id="t-record"></table></div>
</section>

<section aria-label="Call record">
  <h2>Call record</h2>
  <p class="sub" id="call-sub"></p>
  <div class="tbl"><table id="t-call"></table></div>
</section>

<section aria-label="Barometer calibration">
  <h2>Barometer calibration</h2>
  <p class="sub" id="cal-sub"></p>
  <div class="tbl"><table id="t-cal"></table></div>
</section>

<section aria-label="Signal history">
  <h2>Working and high-conviction prints since mid-2020</h2>
  <div class="tbl"><table id="t-hist"></table></div>
</section>

<section aria-label="Rules">
  <h2>Rules</h2>
  <div class="tbl"><table id="t-rules"></table></div>
  <p class="note">Data: daily closes from Yahoo Finance via yfinance (SPY, QQQ, HYG, IEF adjusted for distributions; ^VIX, ^VVIX, ^VXN, DX-Y.NYB) and Cboe's DSPX history file. Duration-hedged HYG compounds HYG's daily return minus 0.45 × IEF's. DSPX percentile is its rank within the trailing 252 sessions. Cboe posts DSPX after the close, so DSPX-dependent tiers confirm once it prints. To refresh, re-run research/vol_signal_dashboard/build_dashboard.py and republish.</p>
</section>
</div>

<script type="application/json" id="data">__DATA__</script>
<script>
(() => {
const D = JSON.parse(document.getElementById('data').textContent);
const NS = 'http://www.w3.org/2000/svg';
const el = (tag, attrs = {}, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; };
const h = (tag, cls, txt) => { const e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; };
const f = (v, d = 2) => v == null ? '–' : Number(v).toFixed(d);
const sg = (v, d = 1) => v == null ? '–' : (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(d);
const MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const fd = s => { const [y, m, d] = s.split('-'); return `${MON[+m - 1]} ${+d} ${y}`; };
const fds = s => { const [y, m, d] = s.split('-'); const dt = new Date(Date.UTC(+y, +m - 1, +d)); return `${DOW[dt.getUTCDay()]} ${MON[+m - 1]} ${+d}`; };
const N = D.now, FL = D.flags;
const ord = n => { const v = Math.round(n); const s = ['th','st','nd','rd'], m = v % 100; return v + (s[(m - 20) % 10] || s[m] || s[0]); };

// ---------- header ----------
const asof = document.getElementById('asof');
asof.appendChild(h('span', null, `Built ${D.built_et}`));
asof.appendChild(h('span', D.live ? 'live' : 'closed', D.live ? 'LIVE SESSION · confirms on close' : `CLOSE ${fd(D.last_bar)}`));
asof.appendChild(h('span', null, `DSPX through ${fd(D.dspx_date)}`));

// ---------- call ----------
const BR = D.baro, AC = D.action, L0 = D.ladder[0];
const cw = document.getElementById('call-word');
cw.textContent = AC.now || '–'; cw.className = 'call-word ' + (AC.now || '').toLowerCase();
document.getElementById('call-since').textContent = AC.now ? `since ${fd(AC.since)}` : '';
const nearHi = FL.gate, onDay = L0.today ? "today's" : `${fds(L0.date)}'s`;
let why = '', flip = '';
if (AC.now === 'SELL') {
  why = `Sell print ${fd(AC.last_print)}. Stays SELL through ${fds(AC.sell_through)}; a new print extends it.`;
} else if (nearHi) {
  why = `${BR.reading >= AC.hold_min ? 'Drawdown odds high' : 'Drawdown odds low'}: barometer ${BR.reading == null ? '–' : BR.reading}/10. No sell print in ${AC.sell_hold} sessions.`;
  const needCr = !(FL.credit || FL.d80);
  flip = `SELL at ${onDay} close if VIX ≥ ${f(L0.vix_trig)} (now ${f(N.vix)}) or VXN ≥ ${f(L0.vxn_trig)} (now ${f(N.vxn)}), with VVIX ≤ ${f(L0.vvix_ceiling)} (now ${f(N.vvix)})` +
    (needCr ? `, plus credit's next return below ${sg(L0.credit_cutoff, 2)}% or DSPX ≥ ${f(L0.dspx80)}` : '') + '.';
} else {
  why = `SPY ${sg(N.dd, 2)}% off its ${fd(N.hi_day)} high, ${N.dd > AC.buy_dip ? 'inside' : 'past'} the ${sg(AC.buy_dip, 0)}% line. No sell print in ${AC.sell_hold} sessions.`;
  flip = N.dd > AC.buy_dip ? `HOLD on a close below ${f(N.hi52 * (1 + AC.buy_dip / 100))}.` : `BUY on a close above ${f(N.hi52 * (1 + AC.buy_dip / 100))}.`;
}
document.getElementById('call-why').textContent = why;
document.getElementById('call-flip').textContent = flip;
const CR = p => AC.record.filter(r => r.period === p);
const cells = document.getElementById('call-cells');
CR('post_covid').forEach(r => {
  const c = h('div', `c ${r.action.toLowerCase()}${r.action === AC.now ? ' cur' : ''}`);
  c.appendChild(h('span', 'w', r.action));
  c.appendChild(h('span', null, `next 20d: ${sg(r.r20_med, 1)}% median, up ${f(r.r20_up, 0)}%`));
  c.appendChild(h('span', null, `drop odds: 5% ${f(r.p5, 0)}%, 8% ${f(r.p8, 0)}%`));
  cells.appendChild(c);
});
document.getElementById('call-note').textContent = `Since mid-2020, after each call: SPY's median return over the next 20 sessions and how often it was higher, and the odds of a 5% / 8% drop within 40 sessions.`;
const drv = document.getElementById('baro-drivers');
drv.appendChild(h('span', 'drv-k', BR.reading == null ? 'Barometer paused (SPY off its high)' : `Barometer ${BR.reading}/10`));
BR.drivers.forEach(x => {
  const e = h('span', 'drv ' + (x.push > 2 ? 'up' : x.push < -2 ? 'dn' : ''));
  e.appendChild(document.createTextNode(`${x.name} `)); e.appendChild(h('b', null, x.pct == null ? '–' : ord(x.pct)));
  e.appendChild(document.createTextNode(x.push > 2 ? ' · raises' : x.push < -2 ? ' · lowers' : ' · neutral'));
  drv.appendChild(e);
});

// ---------- chips ----------
const chips = document.getElementById('chips');
function chip(k, on, onText, offText, why, kind) {
  const c = h('div', 'chip' + (on ? ' ' + kind : ''));
  c.appendChild(h('div', 'k', k));
  const st = h('div', 'state'); st.appendChild(h('span', 'dot')); st.appendChild(h('span', null, on ? onText : offText)); c.appendChild(st);
  c.appendChild(h('div', 'why', why));
  chips.appendChild(c);
}
chip('Near-high gate', FL.gate, 'Armed', 'Paused', `SPY ${sg(N.dd, 2)}% vs ${fd(N.hi_day)} high`, 'neutral');
chip('Watch', FL.watch, 'ON', 'off', `VIX ${sg(N.vix10)}% · VXN ${sg(N.vxn10)}% · VVIX ${sg(N.vvix10)}%`, 'alert');
chip('Working', FL.working, 'ON', 'off', `credit ${sg(N.cred10, 2)}% · DSPX ${N.dspx_p1y == null ? '–' : ord(N.dspx_p1y)} pct`, 'alert');
chip('High conviction', FL.high, 'ON', 'off', `needs Watch + credit < 0 + DSPX ≥ 60th`, 'alert');
chip('Low-risk reading', FL.lowrisk, 'ON', 'off', `VXN/VIX ${sg(N.nv10)}% (on below −5%)`, 'calm');
chip('Size flag (DXY)', FL.size, 'ON', 'off', `DXY ${f(N.dxy)} · ${N.dxy_p1y == null ? '–' : ord(N.dxy_p1y)} pct of 1y range (on at 80th)`, 'alert');
const inDD = N.dd <= -3;
const sevText = !inDD ? 'Not in drawdown' : (N.comp <= -40 ? '10%+ regime' : N.comp <= -25 ? 'Severe track' : 'Contained');
chip('Drawdown severity', inDD && N.comp <= -25, sevText, sevText, `ratio ${f(N.ratio)} vs ${f(N.ratio_hi)} on high day (${sg(N.comp)}%)`, 'alert');

// ---------- tables ----------
function table(id, head, rows, opts = {}) {
  const t = document.getElementById(id); t.replaceChildren();
  const tr = h('tr'); head.forEach((c, j) => tr.appendChild(h('th', (opts.left || []).includes(j) ? 'l' : null, c)));
  const th = h('thead'); th.appendChild(tr); t.appendChild(th);
  const tb = h('tbody');
  rows.forEach((r, i) => {
    const row = h('tr', opts.hl && opts.hl(i) ? 'hl' : null);
    r.forEach((c, j) => {
      const td = h('td', (opts.wrap || []).includes(j) ? 'wrap' : ((opts.left || []).includes(j) ? 'l' : null));
      if (c && typeof c === 'object' && c.tag) { td.appendChild(h('span', 'tag ' + (c.cls || ''), c.tag)); if (c.text) td.appendChild(document.createTextNode(' ' + c.text)); }
      else if ((opts.wrap || []).includes(j)) td.appendChild(h('div', 'wrapbox', c));
      else td.textContent = c;
      row.appendChild(td);
    });
    tb.appendChild(row);
  });
  t.appendChild(tb);
}
const st = (on, kind = 'on') => ({ tag: on ? 'ON' : 'off', cls: on ? kind : '' });
const an = fd(D.anchor_date);
table('t-comp', ['Component', 'Now', '10 sessions back', 'Change', 'Rule', 'Status'], [
  ['SPY vs 52-week high', f(N.spy), `high ${f(N.hi52)} (${fd(N.hi_day)})`, `${sg(N.dd, 2)}%`, 'within 1.5% of the high', st(FL.gate, 'calm')],
  ['VIX', f(N.vix), `${f(N.vix_anchor)} (${an})`, `${sg(N.vix10)}%`, '> +10%', st(FL.v)],
  ['VXN', f(N.vxn), `${f(N.vxn_anchor)} (${an})`, `${sg(N.vxn10)}%`, '> +10%', st(FL.vn)],
  ['VVIX', f(N.vvix), `${f(N.vvix_anchor)} (${an})`, `${sg(N.vvix10)}%`, '< half the VIX or VXN move', st(FL.v || FL.vn)],
  ['Credit: HYG − 0.45 × IEF', '–', '–', `${sg(N.cred10, 2)}%`, '< 0', st(FL.credit)],
  ['DSPX percentile, 1 year', f(N.dspx), `as of ${fd(D.dspx_date)}`, N.dspx_p1y == null ? '–' : ord(N.dspx_p1y), '≥ 60th (high), ≥ 80th (working)', st(FL.d60)],
  ['DXY in 1-year range (size flag)', f(N.dxy), `range ${f(N.dxy_lo)}–${f(N.dxy_hi)}`, N.dxy_p1y == null ? '–' : ord(N.dxy_p1y), 'top 20% = size flag', st(FL.size)],
  ['VXN/VIX', f(N.nv, 3), '–', `${sg(N.nv10)}%`, '< −5% = low-risk reading', st(FL.lowrisk, 'calm')],
  ['VVIX/VIX vs high day', f(N.ratio, 3), `${f(N.ratio_hi, 3)} (${fd(N.hi_day)})`, `${sg(N.comp)}%`, `−25% = ${f(N.ratio_25)} · −40% = ${f(N.ratio_40)}`, st(inDD && N.comp <= -25)],
], { left: [0, 4] });

const L = D.ladder;
table('t-ladder', ['Close on', '10 sessions back', 'VIX ≥', 'VXN ≥', 'VVIX ≤ (at min trigger)', 'Credit: next return below', 'DSPX ≥ 60th / 80th', 'DXY ≥ for size flag'],
  L.map((r, i) => [
    r.today ? `Today ${fds(r.date)} (live)` : fds(r.date), fd(r.anchor),
    `${f(r.vix_trig)}  (${f(r.vix_anchor)})`, `${f(r.vxn_trig)}  (${f(r.vxn_anchor)})`, `${f(r.vvix_ceiling)}  (${f(r.vvix_anchor)})`,
    r.credit_cutoff == null ? 'after prior close' : `${sg(r.credit_cutoff, 2)}%`,
    r.dspx60 == null ? '–' : `${f(r.dspx60)} / ${f(r.dspx80)}`,
    r.dxy80 == null ? '–' : f(r.dxy80),
  ]), { hl: i => i === 0 });
document.getElementById('ladder-note').textContent =
  `Watch fires on a close where VIX or VXN is at or above its trigger and VVIX stays under its ceiling. The ceiling rises with the move: 10-sessions-back VVIX × (1 + the VIX or VXN % change ÷ 2). ` +
  `Working also needs credit below its cutoff or DSPX at the 80th-percentile level, ; high conviction needs both credit below the cutoff and DSPX at the 60th. The DXY level only sizes a print, it never blocks one. ` +
  `Credit and DSPX levels apply to the next close only; later rows depend on closes not yet printed.`;

const REC = D.record, RL = { base: 'Any near-high session (base)', watch: 'Watch', working: 'Working', high: 'High conviction', working_size: 'Working, size flag on', working_nosize: 'Working, size flag off' };
const recRow = tier => {
  const a = REC.find(r => r.period === 'since_2015' && r.tier === tier), b = REC.find(r => r.period === 'post_covid' && r.tier === tier);
  const cell = r => [`${f(r.per_year, 1)}`, `${f(r.hit5, 1)}% / ${f(r.hit8, 1)}%`, tier === 'base' ? '–' : `${r.caught5} of ${r.n5} / ${r.caught8} of ${r.n8}`];
  return [RL[tier], ...cell(a), ...cell(b)];
};
table('t-record', ['Tier', '2015→ per yr', '2015→ hit −5% / −8%', '2015→ caught 5%+ / 8%+', 'Post-COVID per yr', 'Post-COVID hit −5% / −8%', 'Post-COVID caught 5%+ / 8%+'],
  ['base', 'watch', 'working', 'high', 'working_size', 'working_nosize'].map(recRow), { hl: i => i === 2 || i === 3 });

const c18 = CR('since_2018'), cpc = CR('post_covid');
document.getElementById('call-sub').textContent = `Every session since ${fd(c18[0].from)} (out-of-sample barometer readings), by the call it carried.`;
table('t-call', ['Call', `${c18[0].from.slice(0, 4)}→ sessions`, 'Next 20d median / up', '−5% / −8% within 40', 'Post-COVID sessions', 'Next 20d median / up', '−5% / −8% within 40'],
  c18.map((r, i) => { const q = cpc[i]; return [r.action, r.sessions, `${sg(r.r20_med, 2)}% / ${f(r.r20_up, 0)}%`, `${f(r.p5, 1)}% / ${f(r.p8, 1)}%`,
    q.sessions, `${sg(q.r20_med, 2)}% / ${f(q.r20_up, 0)}%`, `${f(q.p5, 1)}% / ${f(q.p8, 1)}%`]; }),
  { hl: i => c18[i].action === AC.now });
document.getElementById('cal-sub').textContent = `Each session since ${BR.oos_from ? fd(BR.oos_from) : '–'} is read against the near-high scores of earlier years only, so these are out-of-sample outcomes. The score is the average of the three input percentiles; the reading is its decile among past near-high sessions.`;
table('t-cal', ['Reading', 'Band', 'Sessions', 'SPY −5% within 40', 'SPY −8% within 40', 'Median 40-session low'],
  BR.cal.map(c => [`${c.lo}–${c.hi}`, c.label, c.sessions, `${f(c.p5, 1)}%`, `${f(c.p8, 1)}%`, c.med40 == null ? '–' : `${sg(c.med40, 2)}%`]),
  { left: [1], hl: i => BR.band && BR.cal[i].lo === BR.band.lo });
const HI = D.history.slice().reverse();
table('t-hist', ['Print', 'Tier', 'SPY off high', 'VIX 10d', 'VXN 10d', 'VVIX 10d', 'Credit 10d', 'DSPX pct', 'DXY pct', 'SPY low next 40'],
  HI.map(r => [fd(r.date), { tag: r.tier, cls: r.tier.includes('High') ? 'hi' : 'on' }, `${sg(r.dd, 2)}%`, `${sg(r.vix10)}%`, `${sg(r.vxn10)}%`, `${sg(r.vvix10)}%`,
    `${sg(r.cred10, 2)}%`, r.dspx_p1y == null ? '–' : ord(r.dspx_p1y), r.dxy_p1y == null ? '–' : ord(r.dxy_p1y), r.f40 == null ? 'open' : `${sg(r.f40, 2)}%`]), { left: [1] });

table('t-rules', ['Tier', 'Rule'], [
  ['Call', `SELL: a Working or High conviction print in the last ${AC.sell_hold} sessions. Otherwise, SPY within 1.5% of its high: HOLD at barometer ${AC.hold_min}+, BUY at ${AC.hold_min - 1} or lower. SPY more than 1.5% off its high: BUY down to ${sg(AC.buy_dip, 0)}%, HOLD below.`],
  ['Barometer', `Equal-weight average of ${BR.inputs.length} percentiles, each within its own trailing year: ${BR.inputs.join(', ')}. Inputs chosen ${BR.selected ? fd(BR.selected) : ''} by a walk-forward search over every 3–6 input combination of ten candidates, re-checked monthly. ${BR.evidence || ''} The 1–10 reading is the decile of today\'s score among past near-high sessions.`],
  ['Near-high gate', 'SPY closes within 1.5% of its 52-week closing high. All tiers below are evaluated only when this is armed.'],
  ['Watch', 'VIX up more than 10% over 10 sessions with VVIX up less than half as much, or the same test with VXN in place of VIX.'],
  ['Working', 'Watch + (duration-hedged HYG down over 10 sessions, or DSPX at or above the 80th percentile of its trailing year).'],
  ['High conviction', 'Watch + duration-hedged HYG down over 10 sessions + DSPX at or above the 60th percentile of its trailing year.'],
  ['Size flag (DXY)', 'DXY in the top 20% of its trailing-year range. It sizes a print and never blocks one. Working prints with it on: 52.9% / 35.3% hit −5% / −8% since 2008 vs 30.8% / 11.5% with it off (since mid-2020: 57.1% / 28.6% vs 42.9% / 0.0%). Holds in every period, with UUP or EURUSD in place of DXY, and when any one episode is left out.'],
  ['Low-risk reading', 'VXN/VIX down more than 5% over 10 sessions (VIX outpacing VXN). Near-high sessions with this reading ran 9.4% / 5.2% odds of −5% / −8% vs 19.0% / 8.4% base.'],
  ['Drawdown severity', 'VVIX/VIX compression from its close on the SPY 52-week-high day. More than 25% by the first −5% close: severe track (6 of 8 went to −10% or worse). 40% or more: every case since 2007 was a 10%+ drawdown (9 of 9).'],
], { left: [0, 1], wrap: [1] });

// ---------- charts ----------
const S = D.series, T = S.dates.map(s => Date.parse(s + 'T00:00:00Z')), LAST = T.length - 1;
const BANDS = D.dd_eps.map(e => [Date.parse(e.peak + 'T00:00:00Z'), Date.parse(e.trough + 'T00:00:00Z'), e.depth]);
const PANELS = [
  { title: 'SPY', h: 150, s: [{ k: 'spy', c: 'ink', d: 0 }], markers: true },
  { title: '10-session change %: VIX, VXN, VVIX', h: 170, s: [{ k: 'vix10', c: 'blue', d: 1 }, { k: 'vxn10', c: 'orange', d: 1 }, { k: 'vvix10', c: 'ink', d: 1 }], refs: [10, 0] },
  { title: 'Credit: HYG − 0.45 × IEF, 10-session %', h: 120, s: [{ k: 'cred10', c: 'blue', d: 2 }], refs: [0] },
  { title: 'DSPX percentile, trailing year', h: 120, s: [{ k: 'dspx_p1y', c: 'blue', d: 0 }], refs: [60, 80], fixed: [0, 100] },
  { title: 'DXY percentile, trailing year (size flag at 80)', h: 120, s: [{ k: 'dxy_p1y', c: 'blue', d: 0 }], refs: [80], fixed: [0, 100] },
  { title: 'VVIX/VIX', h: 130, s: [{ k: 'ratio', c: 'blue', d: 2 }] },
  { title: 'Barometer, 1–10 (near-high sessions only)', h: 120, s: [{ k: 'baro', c: 'orange', d: 0 }], refs: [4.5, 8.5], fixed: [1, 10] },
];
const ML = 48, MR = 50, MT = 20, XB = 22;
let i0 = 0, cur = LAST, built = [];
const nice = (lo, hi, n = 4) => { const sp = hi - lo, s0 = sp / n, mag = 10 ** Math.floor(Math.log10(s0)), r = s0 / mag; const step = (r < 1.5 ? 1 : r < 3 ? 2 : r < 7 ? 5 : 10) * mag; const out = []; for (let v = Math.ceil(lo / step) * step; v <= hi + 1e-9; v += step) out.push(+v.toFixed(6)); return out; };
const stack = document.getElementById('stack');
function setRange(days) { if (days === 'all') i0 = 0; else { const cut = T[LAST] - days * 864e5; i0 = Math.max(0, T.findIndex(t => t >= cut)); } }
function draw() {
  stack.replaceChildren(); built = [];
  const W = Math.max(280, stack.clientWidth - 8), pw = W - ML - MR, t0 = T[i0], t1 = T[LAST];
  const x = t => ML + (t - t0) / (t1 - t0) * pw;
  PANELS.forEach((P, pi) => {
    const last = pi === PANELS.length - 1, H = P.h + (last ? XB : 0);
    const wrap = h('div', 'panel'); wrap.appendChild(h('div', 'ttl', P.title));
    const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, height: H, role: 'img', 'aria-label': P.title }, wrap);
    let lo = Infinity, hi = -Infinity;
    P.s.forEach(s => { for (let i = i0; i <= LAST; i++) { const v = S[s.k][i]; if (v != null) { lo = Math.min(lo, v); hi = Math.max(hi, v); } } });
    (P.refs || []).forEach(r => { lo = Math.min(lo, r); hi = Math.max(hi, r); });
    if (P.fixed) { lo = P.fixed[0]; hi = P.fixed[1]; } else { const pad = (hi - lo) * 0.08 || 1; lo -= pad; hi += pad; }
    const y = v => MT + (1 - (v - lo) / (hi - lo)) * (P.h - MT - 6);
    BANDS.forEach(([a, b]) => { if (b < t0) return; const xa = x(Math.max(a, t0)), xb = Math.max(x(b), xa + 2); el('rect', { class: 'bandr', x: xa, y: MT - 4, width: xb - xa, height: P.h - MT + 4 }, svg); });
    (P.fixed ? (P.fixed[1] === 10 ? [1, 3, 5, 7, 9, 10] : [0, 20, 40, 60, 80, 100]) : nice(lo, hi)).forEach(v => { el('line', { class: 'gl', x1: ML, x2: ML + pw, y1: y(v), y2: y(v) }, svg); const t = el('text', { x: ML - 6, y: y(v) + 4, 'text-anchor': 'end' }, svg); t.textContent = Math.abs(v) >= 100 ? v.toFixed(0) : (Number.isInteger(v) ? v : v.toFixed(1)); });
    (P.refs || []).forEach(r => el('line', { class: 'ref', x1: ML, x2: ML + pw, y1: y(r), y2: y(r) }, svg));
    const ends = [];
    P.s.forEach(s => {
      let dpath = '', pen = false;
      for (let i = i0; i <= LAST; i++) { const v = S[s.k][i]; if (v == null) { pen = false; continue; } dpath += (pen ? 'L' : 'M') + x(T[i]).toFixed(1) + ',' + y(v).toFixed(1); pen = true; }
      el('path', { class: `ln ${s.c}`, d: dpath }, svg);
      let li = LAST; while (li > i0 && S[s.k][li] == null) li--;
      const lv = S[s.k][li];
      if (lv != null) { el('circle', { class: `pt ${s.c}`, cx: x(T[li]), cy: y(lv), r: 3.5 }, svg); ends.push({ y: y(lv), txt: lv.toFixed(s.d) }); }
    });
    ends.sort((a, b) => a.y - b.y); for (let k = 1; k < ends.length; k++) if (ends[k].y - ends[k - 1].y < 13) ends[k].y = ends[k - 1].y + 13;
    ends.forEach(e => { const t = el('text', { class: 'endlbl', x: ML + pw + 8, y: e.y + 4 }, svg); t.textContent = e.txt; });
    if (P.markers) {
      for (let i = i0; i <= LAST; i++) {
        const v = S.spy[i]; if (v == null) continue;
        if (S.watch[i] && !S.mw[i] && !S.mh[i]) el('circle', { class: 'mk-watch', cx: x(T[i]), cy: y(v), r: 2 }, svg);
      }
      for (let i = i0; i <= LAST; i++) {
        const v = S.spy[i]; if (v == null) continue;
        if (S.mh[i]) el('circle', { class: 'mk-h', cx: x(T[i]), cy: y(v) - 9, r: 5 }, svg);
        else if (S.mw[i]) el('circle', { class: 'mk-w', cx: x(T[i]), cy: y(v) - 9, r: 4.5 }, svg);
      }
    }
    if (last) {
      el('line', { class: 'ax', x1: ML, x2: ML + pw, y1: P.h, y2: P.h }, svg);
      const months = (t1 - t0) / (864e5 * 30.44), step = [1, 2, 3, 6, 12].find(s => pw / (months / s) >= 58) || 12;
      let m = new Date(t0); m = new Date(Date.UTC(m.getUTCFullYear(), m.getUTCMonth() + 1, 1));
      while (m.getTime() <= t1) {
        if (m.getUTCMonth() % step === 0) { const xx = x(m.getTime()); if (xx > ML + 14 && xx < ML + pw - 14) { el('line', { class: 'ax', x1: xx, x2: xx, y1: P.h, y2: P.h + 4 }, svg); const t = el('text', { x: xx, y: P.h + 17, 'text-anchor': 'middle' }, svg); t.textContent = `${MON[m.getUTCMonth()]} '${String(m.getUTCFullYear()).slice(2)}`; } }
        m = new Date(Date.UTC(m.getUTCFullYear(), m.getUTCMonth() + 1, 1));
      }
    }
    const xh = el('line', { class: 'xh', x1: 0, x2: 0, y1: MT - 4, y2: P.h, visibility: 'hidden' }, svg);
    const dots = P.s.map(s => el('circle', { class: `pt ${s.c}`, r: 3.5, cx: 0, cy: 0, visibility: 'hidden' }, svg));
    built.push({ P, svg, xh, dots, x, y });
    stack.appendChild(wrap);
  });
  setCursor(cur);
}
const readout = document.getElementById('readout');
function setCursor(i) {
  cur = Math.max(i0, Math.min(LAST, i));
  built.forEach(b => {
    const xx = b.x(T[cur]), show = cur !== LAST;
    b.xh.setAttribute('x1', xx); b.xh.setAttribute('x2', xx); b.xh.setAttribute('visibility', show ? 'visible' : 'hidden');
    b.P.s.forEach((s, j) => { const v = S[s.k][cur]; if (!show || v == null) { b.dots[j].setAttribute('visibility', 'hidden'); return; } b.dots[j].setAttribute('visibility', 'visible'); b.dots[j].setAttribute('cx', xx); b.dots[j].setAttribute('cy', b.y(v)); });
  });
  const tier = S.hi[cur] ? 'High conviction' : S.wk[cur] ? 'Working' : S.watch[cur] ? 'Watch' : S.gate[cur] ? 'Armed, no tier' : 'Gate paused';
  const items = [['', fd(S.dates[cur])], ['SPY', f(S.spy[cur])], ['off high', `${sg(S.dd[cur], 2)}%`], ['VIX 10d', `${sg(S.vix10[cur])}%`], ['VXN 10d', `${sg(S.vxn10[cur])}%`],
    ['VVIX 10d', `${sg(S.vvix10[cur])}%`], ['credit', `${sg(S.cred10[cur], 2)}%`], ['DSPX pct', S.dspx_p1y[cur] == null ? '–' : f(S.dspx_p1y[cur], 0)], ['DXY pct', S.dxy_p1y[cur] == null ? '–' : f(S.dxy_p1y[cur], 0)], ['ratio', f(S.ratio[cur])], ['barometer', S.baro[cur] == null ? '–' : f(S.baro[cur], 0)], ['tier', tier], ['call', S.act[cur] || '–']];
  readout.replaceChildren(...items.map(([k, v]) => { const s = h('span', null, k ? k + ' ' : ''); s.appendChild(h('b', null, v)); return s; }));
}
function idxAt(cx) {
  const b = built[0]; if (!b) return cur; const r = b.svg.getBoundingClientRect(); const W = Math.max(280, stack.clientWidth - 8);
  const px = (cx - r.left) * (W / r.width), t = T[i0] + (px - ML) / (W - ML - MR) * (T[LAST] - T[i0]);
  let lo = i0, hi = LAST; while (hi - lo > 1) { const m = (lo + hi) >> 1; if (T[m] < t) lo = m; else hi = m; }
  return (t - T[lo] < T[hi] - t) ? lo : hi;
}
stack.addEventListener('pointermove', e => setCursor(idxAt(e.clientX)));
stack.addEventListener('pointerleave', () => setCursor(LAST));
stack.addEventListener('keydown', e => { if (e.key === 'ArrowLeft') { setCursor(cur - 1); e.preventDefault(); } if (e.key === 'ArrowRight') { setCursor(cur + 1); e.preventDefault(); } });
document.querySelectorAll('#range button').forEach(btn => btn.addEventListener('click', () => {
  document.querySelectorAll('#range button').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
  setRange(btn.dataset.d === 'all' ? 'all' : +btn.dataset.d); cur = LAST; draw();
}));
setRange(365); draw();
let rt; addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(draw, 120); });
})();
</script>
